# Muse environment variable reference. This file does not load automatically.
# Export selected values in a trusted shell; do not commit filled-in secrets.

# Optional local project library override; default is ~/.oto
OTO_USER_DATA_DIR=

# Official Mureka music adapter. Paid POST requires explicit approval.
MUREKA_API_KEY=
MUREKA_BASE_URL=https://api.mureka.ai
MUREKA_MODEL=auto

# Official direct-MP3 music providers; each requires explicit paid authorization.
ELEVENLABS_API_KEY=
GEMINI_API_KEY=

# Legacy text-model Pattern API (saved SQLite config takes precedence).
# Provider: local | openai | deepseek | google | anthropic
OTODESK_AI_PROVIDER=local
OTODESK_AI_MODEL=
OTODESK_AI_BASE_URL=
OTODESK_AI_API_KEY=

# Local MIDI/WAV rendering: usually bundled with Muse.app.
OTO_FLUIDSYNTH_PATH=
OTO_SOUNDFONT_PATH=

# Optional absolute path to the StoryPack Bun bridge.
CREATIVE_STORY_RUNNER=
